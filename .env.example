# Server runtime — retrieve actual branch values with Neon CLI; never NEXT_PUBLIC secrets.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
CONTACT_RATE_LIMIT_SECRET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
NEON_MEDIA_FUNCTION_URL=
MEDIA_ORIGIN_SECRET=

# Real R2 bindings are configured in wrangler.jsonc. No S3 credentials needed with bindings.
R2_ACCOUNT_ID=4e577220abb44fa926f2a11b8cf10b55
R2_PRIVATE_BUCKET=mall-documents-stage2
NEXT_DEV_WRANGLER_ENV=stage2
NEXT_DIST_DIR=.next-live

# Public URL and indexing are explicit, independent of server credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000/
SEO_INDEXABLE=false
# Optional NEXT_PUBLIC_R2_PUBLIC_BASE_URL / NEXT_PUBLIC_NEON_MEDIA_BASE_URL override current assets.

# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are injected into Neon media origin, not browser/Worker.
# MEDIA_ORIGIN_SECRET must match app and origin (>=64 chars); cookie/rate secrets >=32 chars.
