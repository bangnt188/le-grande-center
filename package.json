{
  "name": "le-grande-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/backend"
  ],
  "scripts": {
    "pull": "node scripts/pull-submodules.mjs",
    "predev": "npm run build:backend && npm run build:ui",
    "dev": "next dev",
    "prebuild": "npm run check:scene-assets && npm run build:backend && npm run build:ui",
    "build": "next build",
    "postbuild": "node scripts/prepare-public-export.mjs",
    "typecheck": "npm run build:backend && npm run typecheck:backend && npm run build:ui && npm run typecheck:ui && tsc --noEmit",
    "build:ui": "npm run build --workspace=@mall/ui",
    "typecheck:ui": "npm run typecheck --workspace=@mall/ui",
    "preview:ui": "npm run preview:ui --workspace=@mall/ui",
    "test:ui": "npm run test --workspace=@mall/ui",
    "test:admin": "node --import tsx --test tests/admin-repository.test.ts",
    "deploy:dev": "node scripts/publish-dev-pages.mjs",
    "build:backend": "npm run build --workspace=@shared/backend",
    "typecheck:backend": "npm run typecheck --workspace=@shared/backend",
    "test:backend": "npm run test --workspace=@shared/backend",
    "check:backend": "npm run check:integrity --workspace=@shared/backend",
    "test:backend:consumer": "npm run build:backend && node --conditions=react-server --import tsx --test tests/backend-consumer.test.ts",
    "models:export": "node scripts/export-scene-assets.mjs",
    "check:scene-assets": "node scripts/check-scene-assets.mjs",
    "test:scene": "node --import tsx --test tests/viewer-projection.test.ts"
  },
  "dependencies": {
    "@mall/ui": "0.1.0",
    "@shared/backend": "0.2.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0"
  }
}
