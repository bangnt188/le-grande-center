{
  "name": "le-grande-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/backend"
  ],
  "scripts": {
    "pull": "node scripts/pull-submodules.mjs",
    "predev": "npm run media:catalog && npm run build:backend && npm run build:ui",
    "dev": "next dev",
    "dev:live": "node scripts/dev-live.mjs",
    "prebuild": "npm run media:catalog && npm run build:backend && npm run build:ui",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "npm run build:backend && npm run typecheck:backend && npm run build:ui && npm run typecheck:ui && tsc --noEmit",
    "build:ui": "npm run build --workspace=@mall/ui",
    "typecheck:ui": "npm run typecheck --workspace=@mall/ui",
    "preview:ui": "npm run preview:ui --workspace=@mall/ui",
    "test:ui": "npm run test --workspace=@mall/ui",
    "smoke:public": "node scripts/smoke-public-ui.mjs",
    "test:admin": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:database": "node --conditions=react-server --import tsx scripts/test-live-database.mjs",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate-database.ts",
    "media:catalog": "node scripts/generate-admin-media.mjs",
    "auth:set-password": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.root-admin.local scripts/set-root-password.mjs",
    "build:backend": "npm run build --workspace=@shared/backend",
    "typecheck:backend": "npm run typecheck --workspace=@shared/backend",
    "test:backend": "npm run test --workspace=@shared/backend",
    "check:backend": "npm run check:integrity --workspace=@shared/backend"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@mall/ui": "0.1.0",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@neondatabase/auth": "^0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@shared/backend": "0.2.1",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.555.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.150.0"
  }
}
